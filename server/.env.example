# Bắt buộc: chuỗi ngẫu nhiên dài để ký JWT. Tạo bằng: openssl rand -base64 48
JWT_SECRET=
# Cổng public trên máy chủ (mặc định 4789)
PORT=4789
# Cho phép tự đăng ký? true/false. Đặt REGISTRATION_CODE để chỉ người có mã mới đăng ký được.
ALLOW_REGISTRATION=true
REGISTRATION_CODE=
# SMTP để gửi mã quên mật khẩu (bỏ trống ⇒ mã ghi ra log: docker compose logs -f zalo-auth)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
