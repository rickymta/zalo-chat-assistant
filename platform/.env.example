# ── Bắt buộc ─────────────────────────────────────────────────────────────────
# Chuỗi ngẫu nhiên dài để ký JWT. Tạo bằng: openssl rand -base64 48
# ⚠️ Đổi giá trị này = mọi access token đang lưu trên máy người dùng hết hiệu lực ngay lập tức
#    (refresh token vẫn dùng được nên ứng dụng tự lấy token mới — nhưng phiên web thì phải đăng nhập lại).
JWT_SECRET=
# Chuỗi kết nối MongoDB. Trong docker-compose thì `mongo` là tên service.
MONGO_URL=mongodb://mongo:27017/zca

# ── Cổng ─────────────────────────────────────────────────────────────────────
# Giữ 4789 để ứng dụng desktop đang cài không phải đổi địa chỉ máy chủ.
API_PORT=4789
WEB_PORT=4790
# Địa chỉ mà cổng được gắn vào. 127.0.0.1 = chỉ máy này/nginx máy chủ thấy (khuyên dùng); 0.0.0.0 = mở ra mạng.
BIND_IP=127.0.0.1

# ── Phiên & mã đặt lại mật khẩu ──────────────────────────────────────────────
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
RESET_TTL_MIN=30

# ── Đăng ký ──────────────────────────────────────────────────────────────────
# false = đóng tự đăng ký (chỉ quản trị viên tạo tài khoản).
ALLOW_REGISTRATION=true
# Đặt mã để chỉ người có mã mới đăng ký được; để trống là ai cũng đăng ký được.
REGISTRATION_CODE=
# Email (cách nhau dấu phẩy) được nâng lên quyền admin khi đăng nhập và khi chạy migrate.
ADMIN_EMAILS=

# ── Đường dẫn & tệp ──────────────────────────────────────────────────────────
# Gốc URL công khai để dựng downloadUrl trong phản hồi API — phải là địa chỉ NGƯỜI DÙNG gõ được
# (thường là địa chỉ web, nginx proxy /downloads sang api), không phải tên service trong Docker.
PUBLIC_URL=http://localhost:4790
RELEASES_DIR=/data/releases
UPLOADS_DIR=/data/uploads

# ── CORS ─────────────────────────────────────────────────────────────────────
# Danh sách origin của trang web được gọi API (cách nhau dấu phẩy). Ứng dụng desktop không gửi Origin
# nên không cần khai ở đây.
CORS_ORIGINS=http://localhost:4790,http://localhost:5174

# ── SMTP (bỏ trống ⇒ mã đặt lại mật khẩu GHI RA LOG: docker compose logs -f api) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

APP_NAME=Zalo Chat Assistant
