# .env cho máy chủ volcanion.vn — chép thành platform/.env trên máy chủ (quyền 600). KHÔNG commit.
# Điền xong chỉ cần MỘT lệnh: docker compose up -d   (mongo + api + web + edge/HTTPS)

# Tên miền chính (trang web + API + tải bản cài) và tên miền quản trị; email nhận cảnh báo chứng chỉ.
DOMAIN=volcanion.vn
ADMIN_DOMAIN=admin.volcanion.vn
ACME_EMAIL=quandh@meddental.vn

# GIỮ NGUYÊN giá trị JWT_SECRET của máy hiện tại nếu chuyển dữ liệu người dùng sang (xem DEPLOY.md mục 6).
# Đổi giá trị = phiên web phải đăng nhập lại; ứng dụng desktop tự lấy token mới bằng refresh token nên không sao.
JWT_SECRET=

# MongoDB: dùng container `mongo` trong compose (mặc định), hoặc Mongo sẵn có/Atlas:
#   MONGO_URL=mongodb://user:pass@10.0.0.5:27017/zca?authSource=admin
#   MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/zca
# Dùng Mongo ngoài thì bỏ service mongo: docker compose up -d api web
MONGO_URL=mongodb://mongo:27017/zca

# api/web chỉ gắn vào loopback; ra ngoài chỉ có edge ở 80/443.
BIND_IP=127.0.0.1
API_PORT=4789
WEB_PORT=4790
ADMIN_PORT=4792

ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
RESET_TTL_MIN=30

# Đăng ký: khuyên đóng (false) hoặc đặt REGISTRATION_CODE để chỉ người trong công ty tạo được tài khoản.
ALLOW_REGISTRATION=true
REGISTRATION_CODE=
# Email được nâng quyền admin khi đăng nhập (vào admin.volcanion.vn).
ADMIN_EMAILS=quandh@meddental.vn,anv@meddental.vn

# Gốc URL công khai — dùng để dựng downloadUrl trả cho ứng dụng và trang tải.
PUBLIC_URL=https://volcanion.vn
RELEASES_DIR=/data/releases
UPLOADS_DIR=/data/uploads

# Origin của trang web được gọi API (ứng dụng desktop không gửi Origin nên không cần khai).
CORS_ORIGINS=https://volcanion.vn,https://www.volcanion.vn,https://admin.volcanion.vn

# SMTP để gửi mã đặt lại mật khẩu; bỏ trống ⇒ mã ghi ra log api (docker compose logs -f api).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

APP_NAME=Zalo Chat Assistant
