# ── Cổng vào nginx (service `edge`) — thay Caddy. Biến ${DOMAIN} ${ADMIN_DOMAIN} do image nginx envsubst khi khởi động.
#   volcanion.vn (+www)  → container web  (SPA + proxy /api,/downloads,/uploads sang api)
#   admin.volcanion.vn   → container admin
# Chứng chỉ Let's Encrypt (một cert phủ cả 3 tên) lấy/gia hạn bằng service certbot; xem deploy/nginx-edge/init-letsencrypt.sh.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# HTTP: cho ACME kiểm chứng + đẩy hết sang HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN} ${ADMIN_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# Trang chính + API + tải bản cài
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    if ($host = www.${DOMAIN}) { return 301 https://${DOMAIN}$request_uri; }

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    proxy_hide_header Strict-Transport-Security;   # api (helmet) cũng gửi HSTS — tránh trùng
    server_tokens off;

    # Khu quản trị chỉ ở admin.<domain>
    location ^~ /admin      { return 404; }
    location ^~ /api/admin/ { return 404; }

    client_max_body_size 10m;

    # Bản cài .dmg/.exe: stream thẳng, không đệm
    location /downloads/ {
        proxy_pass              http://web:80;
        proxy_http_version      1.1;
        proxy_set_header        Connection        "";
        proxy_set_header        Host              $host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto https;
        proxy_buffering         off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout      600s;
    }

    location / {
        proxy_pass         http://web:80;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
}

# Quản trị (ứng dụng riêng), nhận tệp cài tới 600 MB
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    proxy_hide_header Strict-Transport-Security;
    server_tokens off;

    client_max_body_size    600m;
    client_body_timeout     600s;
    proxy_request_buffering off;
    proxy_read_timeout      600s;
    proxy_send_timeout      600s;

    # Không cho đăng ký ở tên miền quản trị
    location = /dang-ky           { return 302 /dang-nhap; }
    location = /api/auth/register { return 404; }

    location / {
        proxy_pass         http://admin:80;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
    }
}
