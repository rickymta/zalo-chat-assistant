{
  "name": "zalo-chat-assistant",
  "version": "0.1.0-beta.4",
  "private": true,
  "description": "Chat Assistant — lưu tin nhắn Zalo và Telegram (mã hoá) trên máy, tổng hợp bằng AI cục bộ, gợi ý trả lời, bản tin giọng nói.",
  "type": "module",
  "main": "electron/main.js",
  "author": "MedDental",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/ensure-native.js node && node src/index.js",
    "export": "node scripts/ensure-native.js node && node src/cli-export.js",
    "seed:demo": "node scripts/ensure-native.js node && node src/dev-seed.js",
    "app": "node scripts/ensure-native.js electron && electron .",
    "icon": "bash scripts/make-icon.sh",
    "dist": "node scripts/ensure-native.js electron && electron-builder --mac dmg",
    "dist:x64": "node scripts/ensure-native.js electron-x64 && electron-builder --mac dmg --x64",
    "dist:win": "node scripts/ensure-native.js electron-win && electron-builder --win nsis --x64",
    "ui": "node ui-src/gen-ui-v4.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "imapflow": "^2.0.0",
    "mailparser": "^3.9.23",
    "node-llama-cpp": "^3.20.0",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22",
    "zca-js": "^2.1.2"
  },
  "build": {
    "appId": "vn.meddental.chat-assistant",
    "productName": "Chat Assistant",
    "copyright": "MedDental",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "electron/**/*",
      "cowork/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/better-sqlite3/build/Release/{test_extension.node,sqlite3.a,.forge-meta}",
      "!node_modules/better-sqlite3/build/Release/{obj,obj.target,.deps}/**",
      "!node_modules/better-sqlite3/{deps,src}/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Chat Assistant",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ]
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  }
}
